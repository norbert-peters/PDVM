  "USAGE_EXAMPLE": {
    "description": "Wie man diese Templates in der Datenbank verwendet",
    "steps": [
      "1. Templates in GUID 55555555-5555-5555-5555-555555555555 speichern",
      "2. Gruppe 'LIST_TEMPLATES' erstellen",
      "3. Für jedes Template ein Feld anlegen (z.B. 'list_anrede', 'list_land')",
      "4. Als Wert das JSON-Template speichern",
      "5. In Control-Definition: type='edit_list' und list_name='anrede' setzen",
      "6. System sucht automatisch: list_anrede → list_default → fallback"
    ],
    "control_definition_example": {
      "name": "dropdown_anrede",
      "label": "Anrede-Optionen",
      "type": "edit_list",
      "list_name": "anrede",
      "description": "Verwaltet die Anrede-Optionen für verschiedene Sprachen"
    },
    "data_structure_example": {
      "description": "Wie Dropdown-Daten in der Datenbank gespeichert werden",
      "table": "sys_dropdowns (oder beliebige Tabelle)",
      "guid": "12345678-1234-1234-1234-123456789abc",
      "gruppe": "DEU",
      "feld": "anrede",
      "wert": [
        {"key": "herr", "value": "Herr", "titel": "Hr."},
        {"key": "frau", "value": "Frau", "titel": "Fr."},
        {"key": "divers", "value": "Divers", "titel": "Mx."}
      ]
    },
    "multi_language_structure": {
      "description": "Für mehrsprachige Dropdowns mehrere Gruppen verwenden",
      "examples": [
        {
          "gruppe": "DEU",
          "feld": "anrede",
          "wert": [
            {"key": "herr", "value": "Herr", "titel": "Hr."},
            {"key": "frau", "value": "Frau", "titel": "Fr."}
          ]
        },
        {
          "gruppe": "ENG",
          "feld": "anrede",
          "wert": [
            {"key": "herr", "value": "Mr.", "titel": "Mr."},
            {"key": "frau", "value": "Mrs.", "titel": "Mrs."}
          ]
        },
        {
          "gruppe": "USA",
          "feld": "anrede",
          "wert": [
            {"key": "herr", "value": "Mr.", "titel": "Mr."},
            {"key": "frau", "value": "Ms.", "titel": "Ms."}
          ]
        }
      ],
      "usage": "System holt Dropdown aus ROOT.DEFAULT_LANGUAGE wenn nicht explizit angegeben"
    }
  },
