# -*- coding: utf-8 -*-
"""
PDVM Menu Handler - Menü-Aktionen ausführen

Führt Menü-Aktionen aus basierend auf command-Daten.
"""
import logging
from typing import Dict, Any, Optional

logger = logging.getLogger(__name__)

_MENU_HANDLER_INSTANCE: Optional['PdvmMenuHandler'] = None

def get_menu_handler(main_window) -> 'PdvmMenuHandler':
    global _MENU_HANDLER_INSTANCE
    if _MENU_HANDLER_INSTANCE is None:
        logger.info("Menu-Handler erstellt")
        _MENU_HANDLER_INSTANCE = PdvmMenuHandler(main_window)
    return _MENU_HANDLER_INSTANCE

class PdvmMenuHandler:
    def __init__(self, main_window):
        self.main_window = main_window
        self._handlers: Dict[str, callable] = {
            'open_view': self._handle_open_view,
            'show_dialog': self._handle_show_dialog,
            'toggle_menu': self._handle_toggle_menu,
            'open_app_menu': self._handle_open_app_menu,
        }
        logger.info("Menu-Handler initialisiert")
    
    def execute_command(self, command_data: Dict[str, Any]) -> bool:
        if not command_data:
            return False
        handler_name = command_data.get('handler')
        params = command_data.get('params', {})
        if not handler_name:
            return False
        handler = self._handlers.get(handler_name)
        if not handler:
            logger.error(f"Unbekannter Handler: {handler_name}")
            return False
        try:
            handler(params)
            return True
        except Exception as e:
            logger.error(f"Handler-Fehler '{handler_name}': {e}")
            return False
    
    def register_handler(self, name: str, handler: callable):
        self._handlers[name] = handler
    
    def _handle_open_view(self, params: Dict[str, Any]):
        view_guid = params.get('view_guid')
        title = params.get('title', 'View')
        if view_guid and hasattr(self.main_window, 'open_view'):
            self.main_window.open_view(view_guid, title)
    
    def _handle_show_dialog(self, params: Dict[str, Any]):
        from PyQt5.QtWidgets import QMessageBox
        title = params.get('title', 'Information')
        message = params.get('message', '')
        QMessageBox.information(self.main_window, title, message)
    
    def _handle_toggle_menu(self, params: Dict[str, Any]):
        menu_guid = params.get('menu_guid')
        if not menu_guid:
            return
        from pdvm_central_systemsteuerung import get_gcs
        gcs = get_gcs()
        if gcs:
            current = gcs.get_menu_panel_visible(menu_guid)
            gcs.set_menu_panel_visible(menu_guid, not current)
    
    def _handle_open_app_menu(self, params: Dict[str, Any]):
        app_name = params.get('app_name')
        logger.info(f"App-Menu: {app_name} (noch nicht implementiert)")
