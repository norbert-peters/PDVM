"""
PDVM Menu System - Autonomes Menu-Verwaltungs-System

ARCHITEKTUR:
- Vollständig autonom - holt Container-Referenzen aus GCS
- load_startmenu(startmenu_guid) lädt alle 3 Menü-Gruppen
- Keine Rückgabewerte nötig
- Container-Referenzen werden vom Systemstart in GCS registriert

VERWENDUNG:
    from pdvm_menu_system_autonomous import PdvmMenuSystemAutonomous
    
    # Container in GCS registrieren (macht Systemstart)
    gcs.register_menu_containers(
        vertical_container=vertical_menu_container,
        grund_container=grund_menu_container,
        zusatz_container=zusatz_menu_container
    )
    
    # Autonomes Menü-Laden
    PdvmMenuSystemAutonomous.load_startmenu(startmenu_guid)
"""

import logging
from pdvm_menu_system import PdvmMenuLoader
from pdvm_menu_pipeline import get_menu_pipeline

logger = logging.getLogger(__name__)


class PdvmMenuSystemAutonomous:
    """
    Autonomes Menü-System - rendert VERTIKAL/GRUND/ZUSATZ in Container.
    
    Container-Referenzen werden aus GCS geholt (vom Systemstart registriert).
    """
    
    @staticmethod
    def load_startmenu(startmenu_guid, menu_handler=None):
        """
        Lädt Startmenü autonom in Container.
        
        Args:
            startmenu_guid: GUID des Startmenüs aus sys_menudaten
            menu_handler: Optional - Menu-Handler für Command-Execution
            
        Returns:
            None (Menüs werden direkt in Container gerendert)
        """
        logger.info(f"🚀 PdvmMenuSystemAutonomous.load_startmenu({startmenu_guid})...")
        
        # GCS holen (autonom!)
        from pdvm_central_systemsteuerung import get_gcs
        gcs = get_gcs()
        
        if not gcs:
            logger.error("❌ GCS nicht verfügbar - kann Menüs nicht laden")
            return
        
        # Container-Referenzen aus GCS holen
        if not hasattr(gcs, '_menu_containers'):
            logger.error("❌ Menu-Container nicht in GCS registriert!")
            logger.error("   Systemstart muss gcs.register_menu_containers() aufrufen!")
            return
        
        containers = gcs._menu_containers
        vertical_container = containers.get('vertical')
        grund_container = containers.get('grund')
        zusatz_container = containers.get('zusatz')  # Kann None sein
        
        if not all([vertical_container, grund_container]):  # ZUSATZ optional!
            logger.error("❌ Nicht alle Menu-Container registriert!")
            return
        
        logger.info("✅ Alle Menu-Container gefunden")
        
        # Menü-Gruppen laden (nur wenn Container vorhanden)
        menu_groups = {
            'VERTIKAL': vertical_container,
            'GRUND': grund_container,
        }
        
        if zusatz_container:
            menu_groups['ZUSATZ'] = zusatz_container
            logger.info("  🔧 ZUSATZ-Container verfügbar")
        else:
            logger.warning("  ⚠️ ZUSATZ-Container nicht registriert (übersprungen)")
        
        for gruppe, container in menu_groups.items():
            try:
                logger.info(f"🎯 Lade Menü: {gruppe}")
                
                # Pipeline holen/erstellen (menu_db aus GCS!)
                pipeline = get_menu_pipeline(gruppe, gcs._menu_system_db)
                pipeline.run('BASIS')  # Basis-Daten laden
                
                # Projektierte Matrix holen
                matrix, _ = pipeline.get_projected_data()
                
                if not matrix:
                    logger.warning(f"⚠️ Keine Menü-Daten für {gruppe}")
                    continue
                
                logger.info(f"✅ Menü '{gruppe}' geladen: {len(matrix)} Items")
                
                # 🎯 RENDERING-STRATEGIE AUS PIPELINE (META-gesteuert!)
                rendering_mode = pipeline.rendering_mode
                logger.info(f"  🎯 Rendering-Mode: {rendering_mode}")
                
                # Richtung bestimmen: vert = vertikal, hori_1/hori_2 = horizontal
                direction = 'vertical' if rendering_mode == 'vert' else 'horizontal'
                
                # Einheitliches Button-Menü rendern
                logger.info(f"  🔧 Rendere {gruppe} als {direction.upper()} Button-Menü")
                PdvmMenuSystemAutonomous._render_unified_button_menu(
                    matrix, container, direction, menu_handler
                )
                
                logger.info(f"✅ Menü '{gruppe}' gerendert")
                
            except Exception as e:
                logger.error(f"❌ Fehler beim Laden von {gruppe}: {e}")
                import traceback
                logger.error(traceback.format_exc())
        
        logger.info("✅ Alle System-Menüs geladen")
    
    @staticmethod
    def _render_unified_button_menu(matrix, container, direction, menu_handler):
        """
        EINHEITLICHES BUTTON-MENÜ-SYSTEM für beide Richtungen.
        
        Args:
            matrix: Menu-Daten (projektierte Matrix)
            container: QFrame Container zum Rendern
            direction: 'vertical' oder 'horizontal'
            menu_handler: Menu-Handler für Command-Execution
            
        Verhalten:
            - Root-Items: vertikal=untereinander, horizontal=nebeneinander
            - Root-Label: ERSTE 4 BUCHSTABEN anzeigen
            - Submenu-Items: Initial zugeklappt, klappbar mit Einrückung
            - Hierarchie: Rekursiv mit Einrückung (indent_level * 20px)
        """
        from PyQt5.QtWidgets import QVBoxLayout, QHBoxLayout, QPushButton, QFrame
        from PyQt5.QtCore import Qt
        
        logger.info(f"🔧 Rendering unified button menu ({direction})...")
        
        # Layout holen oder erstellen
        layout = container.layout()
        if layout is None:
            logger.info("  📦 Erstelle neues Layout für Container")
            if direction == 'vertical':
                layout = QVBoxLayout(container)
            else:
                layout = QHBoxLayout(container)
            layout.setContentsMargins(5, 5, 5, 5)
            layout.setSpacing(5)
        else:
            # Altes Layout clearen
            logger.info("  ♻️ Cleane existierendes Layout")
            while layout.count():
                child = layout.takeAt(0)
                if child.widget():
                    child.widget().deleteLater()
        
        # Container-Widget für Menü-Items
        menu_widget = QFrame()
        if direction == 'vertical':
            menu_layout = QVBoxLayout(menu_widget)
        else:
            menu_layout = QHBoxLayout(menu_widget)
        menu_layout.setContentsMargins(0, 0, 0, 0)
        menu_layout.setSpacing(5)
        
        # Root-Items finden (parent_guid = None)
        root_items = [item for item in matrix if item.get('parent_guid') is None]
        root_items.sort(key=lambda x: x.get('sort_order', 0))
        
        # Expandable State für Submenus (GUID → expanded Bool)
        expanded_state = {}
        
        # Root-Items rendern
        for root_item in root_items:
            item_type = root_item.get('type', 'BUTTON')
            label = root_item.get('label', 'Menu')
            guid = root_item.get('guid')
            
            # ERSTE 4 BUCHSTABEN für Root-Items
            display_label = label[:4] if len(label) > 4 else label
            
            if item_type == 'SUBMENU':
                # Root-Submenu-Button (klappbar)
                btn = QPushButton(f"▶ {display_label}")
                btn.setStyleSheet("""
                    QPushButton {
                        padding: 10px 15px;
                        background-color: #34495e;
                        color: white;
                        border: none;
                        border-radius: 3px;
                        font-size: 13px;
                        font-weight: bold;
                        text-align: left;
                    }
                    QPushButton:hover {
                        background-color: #3498db;
                    }
                    QPushButton:pressed {
                        background-color: #2980b9;
                    }
                """)
                
                # Submenu-Container (initial versteckt)
                submenu_container = QFrame()
                submenu_layout = QVBoxLayout(submenu_container)
                submenu_layout.setContentsMargins(0, 0, 0, 0)
                submenu_layout.setSpacing(2)
                submenu_container.setVisible(False)
                
                # Toggle-Funktion für Expand/Collapse
                expanded_state[guid] = False
                
                def toggle_submenu(checked=False, btn=btn, container=submenu_container, guid=guid):
                    is_expanded = expanded_state.get(guid, False)
                    expanded_state[guid] = not is_expanded
                    
                    if expanded_state[guid]:
                        btn.setText(f"▼ {display_label}")
                        container.setVisible(True)
                    else:
                        btn.setText(f"▶ {display_label}")
                        container.setVisible(False)
                
                btn.clicked.connect(toggle_submenu)
                
                # Submenu-Items rekursiv rendern
                PdvmMenuSystemAutonomous._render_submenu_items_recursive(
                    matrix, guid, submenu_layout, menu_handler, indent_level=1
                )
                
                # Zu Layout hinzufügen
                menu_layout.addWidget(btn)
                menu_layout.addWidget(submenu_container)
                logger.info(f"  ✅ Root-Submenu '{display_label}' hinzugefügt (klappbar)")
                
            elif item_type == 'BUTTON':
                # Root-Button (ohne Submenu)
                btn = QPushButton(display_label)
                btn.setStyleSheet("""
                    QPushButton {
                        padding: 10px 15px;
                        background-color: #2c3e50;
                        color: white;
                        border: none;
                        border-radius: 3px;
                        font-size: 13px;
                    }
                    QPushButton:hover {
                        background-color: #34495e;
                    }
                    QPushButton:pressed {
                        background-color: #1abc9c;
                    }
                """)
                command = root_item.get('command')
                if command and menu_handler:
                    btn.clicked.connect(
                        lambda checked=False, cmd=command: menu_handler.execute_command(cmd)
                    )
                menu_layout.addWidget(btn)
                logger.info(f"  ✅ Root-Button '{display_label}' hinzugefügt")
        
        # Spacer am Ende (nur bei vertikal)
        if direction == 'vertical':
            menu_layout.addStretch()
        
        layout.addWidget(menu_widget)
        logger.info(f"✅ Unified button menu gerendert: {len(root_items)} Root-Items ({direction})")
    
    @staticmethod
    def _render_submenu_items_recursive(matrix, parent_guid, layout, menu_handler, indent_level=1):
        """
        Rendert Submenu-Items rekursiv mit Einrückung.
        
        Args:
            matrix: Menu-Daten
            parent_guid: GUID des Parent-Items
            layout: Layout für Child-Items
            menu_handler: Menu-Handler
            indent_level: Einrückungs-Ebene (1, 2, 3, ...)
        """
        from PyQt5.QtWidgets import QPushButton, QFrame
        
        # Kinder finden
        children = [item for item in matrix if item.get('parent_guid') == parent_guid]
        children.sort(key=lambda x: x.get('sort_order', 0))
        
        for child in children:
            item_type = child.get('type', 'BUTTON')
            label = child.get('label', 'Item')
            guid = child.get('guid')
            
            # Einrückung berechnen
            indent_px = indent_level * 20
            
            if item_type == 'SUBMENU':
                # Nested Submenu (weitere Einrückung)
                btn = QPushButton(f"{'  ' * indent_level}▶ {label}")
                btn.setStyleSheet(f"""
                    QPushButton {{
                        padding: 8px 15px;
                        padding-left: {15 + indent_px}px;
                        background-color: #95a5a6;
                        color: white;
                        border: none;
                        border-radius: 3px;
                        font-size: 12px;
                        text-align: left;
                    }}
                    QPushButton:hover {{
                        background-color: #7f8c8d;
                    }}
                """)
                
                # Nested Submenu Container
                nested_container = QFrame()
                nested_layout = layout.__class__(nested_container)
                nested_layout.setContentsMargins(0, 0, 0, 0)
                nested_layout.setSpacing(2)
                nested_container.setVisible(False)
                
                # Toggle für Nested Submenu
                def toggle_nested(checked=False, btn=btn, container=nested_container, label=label):
                    is_visible = container.isVisible()
                    if is_visible:
                        btn.setText(f"{'  ' * indent_level}▶ {label}")
                        container.setVisible(False)
                    else:
                        btn.setText(f"{'  ' * indent_level}▼ {label}")
                        container.setVisible(True)
                
                btn.clicked.connect(toggle_nested)
                
                # Rekursiv nested Items rendern
                PdvmMenuSystemAutonomous._render_submenu_items_recursive(
                    matrix, guid, nested_layout, menu_handler, indent_level + 1
                )
                
                layout.addWidget(btn)
                layout.addWidget(nested_container)
                logger.info(f"  📁 Nested Submenu '{label}' hinzugefügt (Ebene {indent_level})")
                
            elif item_type == 'BUTTON':
                # Child-Button mit Einrückung
                btn = QPushButton(label)
                btn.setStyleSheet(f"""
                    QPushButton {{
                        padding: 8px 15px;
                        padding-left: {15 + indent_px}px;
                        background-color: #ecf0f1;
                        color: #2c3e50;
                        border: none;
                        border-radius: 3px;
                        font-size: 12px;
                        text-align: left;
                    }}
                    QPushButton:hover {{
                        background-color: #3498db;
                        color: white;
                    }}
                    QPushButton:pressed {{
                        background-color: #2980b9;
                    }}
                """)
                command = child.get('command')
                if command and menu_handler:
                    btn.clicked.connect(
                        lambda checked=False, cmd=command: menu_handler.execute_command(cmd)
                    )
                layout.addWidget(btn)
                logger.info(f"  ✅ Child-Button '{label}' hinzugefügt (Einrückung: {indent_px}px)")
            
            elif item_type == 'SEPARATOR':
                # Separator mit Einrückung
                separator = QFrame()
                separator.setFrameShape(QFrame.HLine)
                separator.setFrameShadow(QFrame.Sunken)
                separator.setStyleSheet(f"""
                    QFrame {{
                        background-color: #bdc3c7;
                        margin-left: {indent_px}px;
                    }}
                """)
                separator.setFixedHeight(2)
                layout.addWidget(separator)
                logger.info(f"  ➖ Separator hinzugefügt (Einrückung: {indent_px}px)")
    
    # ===== ALTE METHODEN (DEPRECATED - werden nicht mehr verwendet) =====
        """Rendert hierarchisches horizontales Menü mit QMenuBar"""
        from PyQt5.QtWidgets import QVBoxLayout, QMenuBar, QAction
        
        logger.info("🔧 Rendering hierarchisches MenuBar...")
        
        # Layout holen oder erstellen
        layout = container.layout()
        if layout is None:
            logger.info("  📦 Erstelle neues Layout für Container")
            layout = QVBoxLayout(container)
            layout.setContentsMargins(0, 0, 0, 0)
            layout.setSpacing(0)
        else:
            logger.info("  ♻️ Verwende existierendes Layout")
        
        # MenuBar erstellen
        menubar = QMenuBar(container)
        menubar.setNativeMenuBar(False)  # Wichtig für Windows!
        menubar.setFixedHeight(40)
        menubar.setStyleSheet("""
            QMenuBar {
                background-color: #2c3e50;
                color: white;
                padding: 5px;
                font-size: 13px;
                font-weight: bold;
            }
            QMenuBar::item {
                padding: 5px 15px;
                background: transparent;
            }
            QMenuBar::item:selected {
                background-color: #34495e;
                border-radius: 3px;
            }
            QMenuBar::item:pressed {
                background-color: #1abc9c;
            }
            QMenu {
                background-color: #ecf0f1;
                border: 2px solid #2c3e50;
                padding: 5px;
            }
            QMenu::item {
                padding: 8px 30px;
                color: #2c3e50;
                font-size: 12px;
                background-color: transparent;
            }
            QMenu::item:selected {
                background-color: #3498db;
                color: white;
                border-radius: 3px;
            }
            QMenu::separator {
                height: 1px;
                background-color: #bdc3c7;
                margin: 5px 10px;
            }
        """)
        
        # Top-Level Items
        top_items = [item for item in matrix if item.get('parent_guid') is None]
        top_items.sort(key=lambda x: x.get('sort_order', 0))
        
        for top_item in top_items:
            item_type = top_item.get('type', 'BUTTON')
            label = top_item.get('label', 'Menu')
            
            if item_type == 'SUBMENU':
                # Rekursives QMenu erstellen
                menu = PdvmMenuSystemAutonomous._create_qmenu_recursive(
                    matrix, top_item.get('guid'), menu_handler
                )
                menu.setTitle(label)
                menubar.addMenu(menu)
                logger.info(f"  ✅ Submenu '{label}' hinzugefügt")
                
            elif item_type == 'BUTTON':
                # Direkter Button
                action = menubar.addAction(label)
                command = top_item.get('command')
                if command and menu_handler:
                    action.triggered.connect(
                        lambda checked=False, cmd=command: menu_handler.execute_command(cmd)
                    )
                logger.info(f"  ✅ Action '{label}' hinzugefügt")
        
        layout.addWidget(menubar)
        logger.info(f"✅ MenuBar mit {len(top_items)} Top-Items gerendert")
    
    @staticmethod
    def _create_qmenu_recursive(matrix, parent_guid, menu_handler):
        """Erstellt QMenu rekursiv mit allen Kindern"""
        from PyQt5.QtWidgets import QMenu, QAction
        
        menu = QMenu()
        
        # Kinder finden
        children = [item for item in matrix if item.get('parent_guid') == parent_guid]
        children.sort(key=lambda x: x.get('sort_order', 0))
        
        for child in children:
            item_type = child.get('type', 'BUTTON')
            label = child.get('label', 'Item')
            
            if item_type == 'SUBMENU':
                # Rekursives Submenu
                submenu = PdvmMenuSystemAutonomous._create_qmenu_recursive(
                    matrix, child.get('guid'), menu_handler
                )
                submenu.setTitle(label)
                menu.addMenu(submenu)
                
            elif item_type == 'BUTTON':
                # Button-Action
                action = QAction(label, menu)
                command = child.get('command')
                if command and menu_handler:
                    action.triggered.connect(
                        lambda checked=False, cmd=command: menu_handler.execute_command(cmd)
                    )
                menu.addAction(action)
                
            elif item_type == 'SEPARATOR':
                menu.addSeparator()
        
        return menu
    
    @staticmethod
    def _render_hierarchical_vertical(matrix, container, menu_handler):
        """
        Rendert hierarchisches vertikales Menü MIT SICHTBAREN SUBMENUS.
        
        SUBMENU-Items werden als Überschriften dargestellt,
        Child-Items als eingerückte Buttons darunter.
        
        Keine Dropdowns - alles sichtbar!
        """
        from PyQt5.QtWidgets import QVBoxLayout, QPushButton, QLabel
        from PyQt5.QtCore import Qt
        
        logger.info("🔧 Rendering hierarchisches vertikales Menü...")
        
        # Layout holen oder erstellen
        layout = container.layout()
        if layout is None:
            logger.info("  📦 Erstelle neues Layout für Container")
            layout = QVBoxLayout(container)
            layout.setContentsMargins(5, 5, 5, 5)
            layout.setSpacing(2)
        else:
            logger.info("  ♻️ Verwende existierendes Layout")
        
        # Rekursive Render-Funktion
        def render_level(parent_guid, indent_level=0):
            """Rendert alle Items mit gegebenem Parent"""
            children = [item for item in matrix if item.get('parent_guid') == parent_guid]
            children.sort(key=lambda x: x.get('sort_order', 0))
            
            for child in children:
                item_type = child.get('type', 'BUTTON')
                label = child.get('label', 'Item')
                guid = child.get('guid')
                
                if item_type == 'SUBMENU':
                    # SUBMENU als Überschrift
                    submenu_label = QLabel(label)
                    submenu_label.setStyleSheet("""
                        QLabel {
                            color: #2c3e50;
                            font-weight: bold;
                            font-size: 10pt;
                            padding: 8px 10px 4px 10px;
                            background-color: transparent;
                        }
                    """)
                    layout.addWidget(submenu_label)
                    logger.info(f"  📁 Submenu-Überschrift '{label}' hinzugefügt")
                    
                    # Rekursiv Children rendern (eingerückt)
                    render_level(guid, indent_level + 1)
                
                elif item_type == 'BUTTON':
                    # Button (eingerückt bei indent_level > 0)
                    indent_px = indent_level * 20
                    btn = QPushButton(label)
                    btn.setStyleSheet(f"""
                        QPushButton {{
                            text-align: left;
                            padding: 8px 15px;
                            padding-left: {15 + indent_px}px;
                            background-color: #ecf0f1;
                            color: #2c3e50;
                            border: none;
                            border-radius: 3px;
                        }}
                        QPushButton:hover {{
                            background-color: #3498db;
                            color: white;
                        }}
                    """)
                    
                    # Command anbinden
                    command = child.get('command')
                    if command and menu_handler:
                        btn.clicked.connect(
                            lambda checked=False, cmd=command: menu_handler.execute_command(cmd)
                        )
                    
                    layout.addWidget(btn)
                    logger.info(f"  ✅ Button '{label}' hinzugefügt (Einrückung: {indent_px}px)")
                
                elif item_type == 'SEPARATOR':
                    # Trennlinie
                    separator = QLabel()
                    separator.setFixedHeight(1)
                    separator.setStyleSheet("background-color: #bdc3c7;")
                    layout.addWidget(separator)
                    logger.info("  ➖ Separator hinzugefügt")
        
        # Top-Level Items rendern (parent_guid=None)
        render_level(None, indent_level=0)
        
        # Stretch am Ende
        layout.addStretch()
        
        logger.info(f"✅ Hierarchisches vertikales Menü mit {len(matrix)} Items gerendert")
    
    @staticmethod
    def _render_flat_vertical(matrix, container, menu_handler):
        """Rendert flaches vertikales Menü (nur Top-Level Buttons)"""
        from PyQt5.QtWidgets import QVBoxLayout, QPushButton
        
        logger.info("🔧 Rendering flaches vertikales Menü...")
        
        # Layout holen oder erstellen
        layout = container.layout()
        if layout is None:
            logger.info("  📦 Erstelle neues Layout für Container")
            layout = QVBoxLayout(container)
            layout.setContentsMargins(5, 5, 5, 5)
            layout.setSpacing(2)
        else:
            logger.info("  ♻️ Verwende existierendes Layout")
        
        # Alle Items (sortiert)
        items = sorted(matrix, key=lambda x: x.get('sort_order', 0))
        
        for item in items:
            if not item.get('visible', True):
                continue
            
            item_type = item.get('type', 'BUTTON')
            label = item.get('label', 'Menu')
            
            if item_type == 'BUTTON':
                btn = QPushButton(label)
                btn.setStyleSheet("""
                    QPushButton {
                        text-align: left;
                        padding: 8px 15px;
                        background-color: #2c3e50;
                        color: white;
                        border: none;
                        border-radius: 3px;
                        font-size: 12px;
                    }
                    QPushButton:hover {
                        background-color: #34495e;
                    }
                    QPushButton:pressed {
                        background-color: #1abc9c;
                    }
                """)
                command = item.get('command')
                if command and menu_handler:
                    btn.clicked.connect(
                        lambda checked=False, cmd=command: menu_handler.execute_command(cmd)
                    )
                layout.addWidget(btn)
                logger.info(f"  ✅ Button '{label}' hinzugefügt")
            
            elif item_type == 'SEPARATOR':
                from PyQt5.QtWidgets import QFrame
                separator = QFrame()
                separator.setFrameShape(QFrame.HLine)
                separator.setFrameShadow(QFrame.Sunken)
                layout.addWidget(separator)
        
        layout.addStretch()
        logger.info(f"✅ Flaches vertikales Menü mit {len(items)} Items gerendert")
    
    @staticmethod
    def _render_flat_horizontal(matrix, container, menu_handler):
        """Rendert flaches horizontales Menü"""
        from PyQt5.QtWidgets import QHBoxLayout, QPushButton
        
        logger.info("🔧 Rendering flaches horizontales Menü...")
        
        # Layout holen oder erstellen
        layout = container.layout()
        if layout is None:
            logger.info("  📦 Erstelle neues Layout für Container")
            layout = QHBoxLayout(container)
            layout.setContentsMargins(5, 5, 5, 5)
            layout.setSpacing(5)
        else:
            logger.info("  ♻️ Verwende existierendes Layout")
        
        # Alle Items (sortiert)
        items = sorted(matrix, key=lambda x: x.get('sort_order', 0))
        
        for item in items:
            if not item.get('visible', True):
                continue
            
            item_type = item.get('type', 'BUTTON')
            label = item.get('label', 'Menu')
            
            if item_type == 'BUTTON':
                btn = QPushButton(label)
                btn.setStyleSheet("""
                    QPushButton {
                        padding: 8px 15px;
                        background-color: #2c3e50;
                        color: white;
                        border: none;
                        border-radius: 3px;
                        font-size: 12px;
                    }
                    QPushButton:hover {
                        background-color: #34495e;
                    }
                    QPushButton:pressed {
                        background-color: #1abc9c;
                    }
                """)
                command = item.get('command')
                if command and menu_handler:
                    btn.clicked.connect(
                        lambda checked=False, cmd=command: menu_handler.execute_command(cmd)
                    )
                layout.addWidget(btn)
                logger.info(f"  ✅ Button '{label}' hinzugefügt")
            
            elif item_type == 'SEPARATOR':
                from PyQt5.QtWidgets import QFrame
                separator = QFrame()
                separator.setFrameShape(QFrame.VLine)
                separator.setFrameShadow(QFrame.Sunken)
                layout.addWidget(separator)
        
        layout.addStretch()
        logger.info(f"✅ Flaches horizontales Menü mit {len(items)} Items gerendert")
